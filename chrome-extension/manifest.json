{
  "manifest_version": 3,
  "name": "ChromiumBridge (to Firefox)",
  "version": "1.0.0",
  "description": "Send active tabs, cookies, and session state from Chromium browsers to Firefox, LibreWolf, Floorp, and more.",
  "permissions": [
    "nativeMessaging",
    "cookies",
    "tabs",
    "storage",
    "contextMenus",
    "activeTab",
    "history",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background/main.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png"
    },
    "default_title": "ChromiumBridge"
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/storage-extractor.js", "content/banner.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+O",
        "mac": "MacCtrl+Shift+O"
      },
      "description": "Open ChromiumBridge popup"
    }
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}

{
  "manifest_version": 2,
  "name": "ChromiumBridge Gecko Companion",
  "version": "1.0.0",
  "description": "Companion extension for ChromiumBridge — receives authenticated tab handoffs from Chromium browsers into Firefox.",

  "browser_specific_settings": {
    "gecko": {
      "id": "chromiumbridge-companion@faisalbhuiyan.com",
      "strict_min_version": "91.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "cookies",
    "storage",
    "tabs",
    "webNavigation",
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background/receiver.js"]
  },

  "content_scripts": [
    {
      "matches": ["*://127.0.0.1:47831/handoff*"],
      "js": ["content/handoff-trigger.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/return-button.js"],
      "run_at": "document_idle"
    }
  ],

  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png"
  }
}
